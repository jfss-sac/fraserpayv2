# Firebase web-app config for the /login client SDK. 
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Service-account credentials for firebase-admin. SECRET — server env only,
# never NEXT_PUBLIC_, never committed.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# School Google account promoted to SAC exec by scripts/seed-superadmin.ts.
SEED_SUPERADMIN_EMAIL=

# Minimum structured-log level: debug | info | warn | error (default info).
LOG_LEVEL=

# Required on Vercel Production and Preview; not needed for local Node 24 development.
NODE_OPTIONS=--experimental-require-module

NEXT_PUBLIC_SITE_URL=

# Optional external school-specific how-to document shown on /account; blank hides the link.
ACCOUNT_HELP_URL=

# SET TRUE FOR DEV
NEXT_PUBLIC_USE_EMULATORS=
# Firestore emulator host:port (e.g. 127.0.0.1:8080). Set by the dev script.
FIRESTORE_EMULATOR_HOST=
# Auth emulator host:port (e.g. 127.0.0.1:9099). Set by the dev script.
FIREBASE_AUTH_EMULATOR_HOST=
# Client-side Auth emulator host:port for the browser SDK; defaults to 127.0.0.1:9099 when NEXT_PUBLIC_USE_EMULATORS=true.
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=
# Extra dev-server origins allowed to request dev assets (comma-separated hostnames), e.g. a LAN IP for on-device testing: 192.168.1.50
DEV_ALLOWED_ORIGINS=
