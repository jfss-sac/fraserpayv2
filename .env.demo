# client (browser SDK → auth emulator)
NEXT_PUBLIC_USE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_API_KEY=demo
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-fraserpay.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-fraserpay
NEXT_PUBLIC_FIREBASE_APP_ID=demo
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# server (admin SDK → firestore + auth emulators)
FIREBASE_PROJECT_ID=demo-fraserpay
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099